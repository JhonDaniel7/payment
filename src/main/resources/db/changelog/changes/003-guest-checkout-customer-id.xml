<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Guest checkout: orders can be placed without an account, so a payment may have no user.
        customer_id stores the JWT subject (a username, not a UUID) as order-service does.
    -->
    <changeSet id="003" author="payment-service">
        <dropNotNullConstraint tableName="payments" columnName="user_id" columnDataType="UUID"/>
        <addColumn tableName="payments">
            <column name="customer_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
