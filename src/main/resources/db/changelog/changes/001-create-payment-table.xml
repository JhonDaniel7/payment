<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="payment-service">
        <createTable tableName="payments">

            <!-- ── IDENTITY & TRACKING ─────────────────────────── -->
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payment_reference" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_payment_reference"/>
            </column>
            <column name="transaction_id" type="VARCHAR(255)"/>
            <column name="external_reference" type="VARCHAR(255)"/>

            <!-- ── PARTIES INVOLVED ────────────────────────────── -->
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="merchant_id" type="UUID"/>

            <!-- ── FINANCIAL DATA ──────────────────────────────── -->
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="exchange_rate" type="DECIMAL(19,6)"/>
            <column name="amount_in_base_currency" type="DECIMAL(19,2)"/>
            <column name="tax_amount" type="DECIMAL(19,2)"/>
            <column name="net_amount" type="DECIMAL(19,2)"/>
            <column name="fee_amount" type="DECIMAL(19,2)"/>

            <!-- ── PAYMENT METHOD & ROUTING ────────────────────── -->
            <column name="payment_method" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_gateway" type="VARCHAR(30)"/>
            <column name="payment_region" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>

            <!-- ── CARD DETAILS (PCI-DSS MASKED) ──────────────── -->
            <column name="masked_card_number" type="VARCHAR(4)"/>
            <column name="card_brand" type="VARCHAR(20)"/>
            <column name="card_holder_name" type="VARCHAR(150)"/>
            <column name="card_expiry" type="VARCHAR(5)"/>

            <!-- ── TIMESTAMPS ──────────────────────────────────── -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="initiated_at" type="TIMESTAMP"/>
            <column name="authorized_at" type="TIMESTAMP"/>
            <column name="captured_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="cancelled_at" type="TIMESTAMP"/>
            <column name="expires_at" type="TIMESTAMP"/>

            <!-- ── REFUND TRACKING ─────────────────────────────── -->
            <column name="refund_amount" type="DECIMAL(19,2)"/>
            <column name="refund_transaction_id" type="VARCHAR(255)"/>
            <column name="refund_reason" type="VARCHAR(500)"/>
            <column name="refunded_at" type="TIMESTAMP"/>

            <!-- ── ERROR & FAILURE TRACKING ───────────────────── -->
            <column name="failure_code" type="VARCHAR(100)"/>
            <column name="failure_reason" type="VARCHAR(500)"/>
            <column name="gateway_error_message" type="VARCHAR(1000)"/>
            <column name="retry_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <!-- ── 3DS / SCA (EU PSD2) ─────────────────────────── -->
            <column name="three_ds_status" type="VARCHAR(20)"/>
            <column name="three_ds_transaction_id" type="VARCHAR(255)"/>

            <!-- ── AUDIT / SECURITY ────────────────────────────── -->
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="device_id" type="VARCHAR(255)"/>

            <!-- ── DESCRIPTIVE / METADATA ──────────────────────── -->
            <column name="description" type="VARCHAR(500)"/>
            <column name="notes" type="VARCHAR(1000)"/>
            <column name="metadata" type="TEXT"/>

        </createTable>

        <!-- ── INDEXES ─────────────────────────────────────────── -->
        <createIndex indexName="idx_payments_order_id" tableName="payments">
            <column name="order_id"/>
        </createIndex>
        <createIndex indexName="idx_payments_user_id" tableName="payments">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_payments_status" tableName="payments">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_payments_transaction_id" tableName="payments">
            <column name="transaction_id"/>
        </createIndex>
        <createIndex indexName="idx_payments_region" tableName="payments">
            <column name="payment_region"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>

